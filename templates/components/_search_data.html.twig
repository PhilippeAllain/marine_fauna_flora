{{ form_start(form) }}
<div class="d-flex justify-content-center align-items-center gap-2 mb-3 mx-auto" style="max-width: 500px;">
	
	{# Bouton Retour #}
	<a href="{{ path('glossary.index') }}" class="btn btn-outline-emerald d-inline-flex align-items-center justify-content-center p-2" title="Retour">
		<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-arrow-left-short" viewBox="0 0 16 16">
			<path fill-rule="evenodd" d="M12 8a.5.5 0 0 1-.5.5H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5H11.5a.5.5 0 0 1 .5.5"/>
		</svg>
	</a>

	{# Barre de recherche responsive #}
	<div class="input-group relative flex-grow-1">
		{{ form_widget(form.q) }}
		<button type="submit" class="btn btn-emerald inline-block">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
				<path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
			</svg>
		</button>
	</div>

</div>
{{ form_end(form) }}

{# Styles CSS émeraude pour les boutons #}
<style>
	.btn-emerald {
		background-color: #198754 !important;
		border-color: #198754 !important;
		color: white !important;
	}
	.btn-emerald:hover, .btn-emerald:active {
		background-color: #0f5132 !important;
		border-color: #0f5132 !important;
	}
	.btn-outline-emerald {
		color: #0f5132 !important;
		border-color: #198754 !important;
		background-color: transparent !important;
	}
	.btn-outline-emerald:hover, .btn-outline-emerald:active {
		background-color: #e8f5e9 !important;
		color: #0f5132 !important;
	}
</style>
