{% extends 'base.html.twig' %}

{% block title 'Océans-Mers' %}

{% block body %}
	<div class="container w-50 mt-4 p-3 border rounded shadow">
		<h1 class="text-center">Océans-Mers</h1>
		<div class="mb-3 p-4 border rounded">
			{% include 'components/_search_data.html.twig' with {'form': form} only %}
		</div>
		<div class="mb-3 p-4 border rounded">

			<table class="table table-primary table-striped-columns">
				<thead>
					<tr>
						<th>Nom</th>
					</tr>
				</thead>
				<tbody>
					{% for sea in seas %}
						<tr>
							<td>
								<a href="{{ path('sea.show', {id: sea.id}) }}">{{ sea.name }}</a>
							</td>
						</tr>
					</td>
				</tbody>
			</tr>
		{% endfor %}
	</tbody>
</table></div><div class="d-flex justify-content-center">{{ knp_pagination_render(seas) }}</div></div>{% endblock %}
