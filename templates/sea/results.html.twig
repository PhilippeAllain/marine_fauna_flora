{% extends 'base.html.twig' %}

{% block title 'Océans-Mers' %}

{% block body %}
	<div class="container w-50 mt-4 p-3 border rounded shadow">
		<h1 class="text-center">Résultat de la recherche</h1>
		<div class="container text-center border border-5 border-primary my-5">
			<div class="row">
				<div class="col-4 align-self-center">

					{% if seas %}
						{% for sea in seas%}
							<div class="container justify-content-center d-flex">
								<h3>
									<a class="text-primary" href="{{ path('sea.show', {id: sea.id}) }}">{{ sea.name }}</a>
								</h3>
							</div>
						{% endfor %}
					{% elseif seas==[] %}

						<h2>Pas de résultat</h2>

					{% endif %}
				</div>

			</div>
			<div class="d-flex justify-content-center">{{ pagerfanta(seas) }}</div>
		</div>
		<div class="container justify-content-center d-flex">
			<a href="{{ path('sea.index') }}" class="btn btn-primary text-center">Retour</a>
		</div>
	</div>
{% endblock %}
