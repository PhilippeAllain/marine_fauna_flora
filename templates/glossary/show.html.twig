{% extends 'base.html.twig' %}

{% block title 'Glossaire : ' ~ glossary.word %}

{% block body %}
	<div class="card text-center mb-3 bg-primary-subtle mx-auto" style="max-width: 600px;">
		{# Image centrée et redimensionnée proprement pour mobile #}
		<div class="d-flex justify-content-center pt-4">
			<img src="{{ vich_uploader_asset(glossary, 'thumbnailFile') }}" alt="{{ glossary.word }}" class="img-fluid px-3" style="max-height: 150px; object-fit: contain;">
		</div>
		
		<div class="card-body px-3 px-sm-4">
			{# Marges réduites (m-5 était trop grand pour un écran de téléphone) #}
			<h1 class="card-title text-center fs-3 my-4">Détails du terme : "{{ glossary.word }}"</h1>
			
			{# fs-5 et fs-6 pour des tailles de texte lisibles mais adaptées #}
			<div class="card-text text-start mb-3 fs-5">
				<strong>Explication : </strong>{{ glossary.content|nl2br }}
			</div>				
			<div class="card-text text-start mb-3 fs-6 text-muted">
				<strong>Exemple : </strong>{{ glossary.example }}
			</div>
		</div>
		
		{# Boutons alignés côte à côte sur grand écran, mais empilés sur mobile #}
		<div class="card-footer text-body-secondary py-3">		
			<div class="row g-2 justify-content-center">
				<div class="col-12 col-sm-auto">
					<a href="{{ glossary.url }}" target="_blank" class="btn btn-primary w-100">Voir la source</a>
				</div>
				<div class="col-12 col-sm-auto">
					<a href="{{ path('glossary.index') }}" class="btn btn-outline-primary w-100">Retour</a>
				</div>			
			</div>
		</div>
	</div>
{% endblock %}
