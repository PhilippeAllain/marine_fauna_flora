{% extends 'base.html.twig' %}

{% block title 'Glossaire : ' ~ glossary.word %}

{% block body %}
	<div class="card text-center mb-3 bg-primary-subtle">
		<img src="{{ vich_uploader_asset(glossary, 'thumbnailFile') }}" alt="{{ glossary.word }}" class="card-img-top img-fluid mb-4 p-4" style="max-width: 200px;">
		<div class="card-body">
			<h1 class="card-title text-center m-5">Détails du terme : "{{ glossary.word }}"</h1>
			<h2 class="card-text text-start"><strong>Eplication: </strong>{{ glossary.content|nl2br }}</h2>				
			<h3 class="card-text text-start"><strong>Exemple: </strong>{{ glossary.example }}</h3>
		</div>
		<div class="card-footer text-body-secondary">		
			<div class="raw m-3"><a href="{{ glossary.url }}" target="_blank" class="btn btn-primary card-link">Voir la source</a></div>
			<div class="raw m-3"><a href="{{ path('glossary.index') }}" class="btn btn-primary card-link">Retour</a></div>			
		</div>
	</div>
{% endblock %}
