{% extends 'base.html.twig' %}

{% block title 'Glossaire : ' ~ glossary.word %}

{% block body %}
	<div class="container w-50 mt-4 p-3 border rounded shadow">

		{% if glossary is not null %}
			<h1 class="mb-4 text-center">Détails du terme : "{{ glossary.word }}"</h1>
			<div class="card">
				<img src="{{ vich_uploader_asset(glossary, 'thumbnailFile') }}" alt="{{ glossary.word }}" class="card-img-top img-fluid mb-4 p-4" style="max-width: 200px;">
				<div class="card-body">
					<h2 class="card-header">{{ glossary.word }}</h2>
					<h3 class="card-title m-3">{{ glossary.content | nl2br }}</h3>
					<h4 class="card-text m-3">
						<strong>Exemples :</strong>
						{{ glossary.example }}</h4>
					<p class="card-text m-3 text-center">
						<a href="{{ glossary.url }}" target="_blank" class="btn btn-info mb-3">Voir la source</a>
					</p>
				</div>
			</div>
		</div>
	{% endif %}

	<div class="container my-4 justify-content-center d-flex gap-3">
		<a href="{{ path('glossary.index') }}" class="btn btn-primary">Retour</a>
	</div>
{% endblock %}
