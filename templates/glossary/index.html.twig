{% extends 'base.html.twig' %}

{% block title 'Glossaire' %}

{% block body %}
	<div class="container-fluid container-md mt-4 p-3 border rounded shadow">
		<h1 class="text-center mb-4">Glossaire</h1>
		
		<div class="mb-3 p-3 p-md-4 border rounded">
			{% include 'components/_search_data.html.twig' with {'form': form} only %}
		</div>
		
		{# Grille responsive : 1 colonne sur mobile, 2 sur tablette, 3 sur ordinateur #}
		<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3 mb-4">
			{% for glossary in glossaries %}
				<div class="col">
					<div class="card h-100 shadow-sm border-primary">
						<div class="card-body d-flex align-items-center justify-content-center text-center">
							<h5 class="card-title m-0">
								<a href="{{ path('glossary.show', {id: glossary.id}) }}" class="text-decoration-none stretched-link">
									{{ glossary.word }}
								</a>
							</h5>
						</div>
					</div>
				</div>
			{% else %}
				<div class="col-12 text-center text-muted py-4">
					Aucun mot trouvé dans le glossaire.
				</div>
			{% endfor %}
		</div>

		<div class="d-flex justify-content-center mt-3">
			{{ knp_pagination_render(glossaries) }}
		</div>
	</div>
{% endblock %}
