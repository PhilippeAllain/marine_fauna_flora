{% extends 'base.html.twig' %}

{% block title 'Glossaire' %}

{% block body %}
	<div class="container-fluid container-md mt-4 p-3 border rounded shadow bg-white text-center">
		{# Titre centré #}
		<h1 class="mb-4 fw-bold" style="color: #0f5132;">Glossaire</h1>
		
		{# Zone de recherche centrée avec largeur maximale contrôlée #}
		<div class="mb-4 p-3 p-md-4 border rounded bg-light mx-auto" style="max-width: 500px;">
			<div class="d-flex justify-content-center w-100">
				{% include 'components/_search_data.html.twig' with {'form': form} only %}
			</div>
		</div>
		
		{# Grille de cartes émeraude centrée #}
		<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3 mb-4 justify-content-center">
			{% for glossary in glossaries %}
				<div class="col">
					<div class="card h-100 border-0 shadow-sm position-relative emerald-card">
						<div class="card-body d-flex align-items-center justify-content-center text-center p-4">
							<h5 class="card-title m-0">
								<a href="{{ path('glossary.show', {id: glossary.id}) }}" class="text-decoration-none stretched-link fw-semibold emerald-text">
									{{ glossary.word }}
								</a>
							</h5>
						</div>
					</div>
				</div>
			{% else %}
				<div class="col-12 text-muted py-5">
					Aucun mot trouvé dans le glossaire.
				</div>
			{% endfor %}
		</div>


		</div>
				{# Pagination centrée #}
		<div class="d-flex justify-content-center mt-3">
			{{ knp_pagination_render(glossaries) }}
	</div>

{% endblock %}
