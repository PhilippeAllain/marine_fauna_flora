{% extends 'base.html.twig' %}

{% block title 'Plante : ' ~ plant.name %}

{% block body %}
	<div class="container w-50 mt-4 p-3 border rounded shadow">

		{% if plant is not null %}
			<h1 class="mb-4 text-center">Détails du terme : "{{ plant.name }}"</h1>
			<div class="card">
				<img src="{{ vich_uploader_asset(plant, 'thumbnailFile') }}" alt="{{ plant.name }}" class="card-img-top img-fluid mb-4 p-4" style="max-width: 200px;">
				<div class="card-body">
					<h2 class="card-header">{{ plant.name }}</h2>
					<h3 class="card-title m-3">{{ plant.content | nl2br }}</h3>
					<p class="card-text m-3 text-center">
						<a href="{{ plant.url }}" target="_blank" class="btn btn-info mb-3">Voir la source</a>
					</p>
				</div>
			</div>
		</div>
	{% endif %}

	<div class="container my-4 justify-content-center d-flex gap-3">
		<a href="{{ path('plant.index') }}" class="btn btn-primary">Retour</a>
	</div>
	
{% endblock %}
