{% extends 'base.html.twig' %}

{% block title 'Les Plantes à Fleurs : ' ~ plant.name %}

{% block body %}
	{% set back_url = app.request.headers.get('referer') %}
	{% set fallback_url = path('plant.index') %}
	{% set is_internal_referer = back_url and app.request.schemeAndHttpHost in back_url %}

	<div class="container-fluid container-md mt-4 p-4 border rounded shadow text-center d-flex flex-column justify-content-between" style="background-color: var(--emerald-blue-light); min-height: auto;">
		
		<div class="d-flex align-items-center mb-4 position-relative justify-content-center">
			<img src="{{ vich_uploader_asset(plant, 'thumbnailFile') }}" alt="{{ plant.name }}" class="img-fluid px-3" style="max-height: 150px; object-fit: contain;">
		</div>
		
		<div class="d-flex flex-column align-items-center mb-4 w-100">
			<h1 class="card-title text-center fs-3 my-4">Détails du terme : "{{ plant.name }}"</h1>
			
			<div class="card-text text-start mb-3 fs-5 w-100" style="max-width: 800px;">
				<strong>Explication : </strong>{{ plant.content|nl2br }}
			</div>				
		</div>
		
		<div class="card-footer text-body-secondary py-3">		
			<div class="row g-2 justify-content-center">
				<div class="col-12 col-sm-auto">
					<a href="{{ plant.url }}" target="_blank" class="btn btn-primary w-100">Voir la source</a>
				</div>
				<div class="col-12 col-sm-auto">
					<a href="{{ is_internal_referer ? back_url : fallback_url }}" class="btn btn-outline-primary w-100">Retour</a>
				</div>			
			</div>
		</div>
	</div>
{% endblock %}

