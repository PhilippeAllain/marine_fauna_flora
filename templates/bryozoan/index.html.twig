{% extends 'base.html.twig' %}

{% block title 'Les bryozoaires' %}

{% block body %}
	<div class="container w-50 mt-4 p-3 border rounded shadow">
		<h1 class="text-center">Bryozoaires</h1>
		<div class="mb-3 p-4 border rounded">
			{% include 'components/_search_data.html.twig' with {'form': form} only %}
		</div>
		<div class="mb-3 p-4 border rounded">

			<table class="table table-primary table-striped-columns">
				<thead>
					<tr>
						<th>{{ knp_pagination_sortable(bryozoans, 'Nom', 'b.name') }}</th>
					</tr>
				</thead>
				<tbody>
					{% for bryozoan in bryozoans %}
						<tr>
							<td>
								<a href="{{ path('bryozoan.show', {id: bryozoan.id}) }}">{{ bryozoan.name }}</a>
							</td>
						</tr>
					</td>
				</tbody>
			</tr>
		{% endfor %}
	</tbody>
</table></div><div class="d-flex justify-content-center">{{ knp_pagination_render(bryozoans) }}</div></div>{% endblock %}
