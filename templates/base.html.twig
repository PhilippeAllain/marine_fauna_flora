<!DOCTYPE html>
<html lang="fr-FR">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="author" content="Philippe Frager"/>
		<meta property="og:description" content="Informations sur la faune et flore marine."/>
		<meta property="og:title" content="Marine Fauna Flora"/>
		<title>{% block title %}Marine Fauna & Flora{% endblock %}</title>

		{% block stylesheets %}
		{% endblock %}

		{% block javascripts %}
			{{ importmap('app') }}
		{% endblock %}
	</head>

	<body class="d-flex flex-column min-vh-100">
		
		<nav class="navbar navbar-expand-lg bg-body-tertiary">
			<div class="container-fluid">
				<a class="navbar-brand" href="{{ path('main.index') }}">Faune & Flore marine</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="collapse navbar-collapse" id="navbarSupportedContent">
					<ul class="navbar-nav me-auto mb-2 mb-lg-0">
						<li class="nav-item">
							<a class="nav-link {{ app.request.attributes.get('_route') starts with 'glossary' ? 'active' : '' }}" aria-current="page" href="{{ path('glossary.index') }}">Glossaire</a>
						</li>
						<li class="nav-item">
							<a class="nav-link {{ app.request.attributes.get('_route') starts with 'sea' ? 'active' : '' }}" href="{{ path('sea.index') }}">Océans-Mers</a>
						</li>
						<li class="nav-item dropdown">
							<a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Les vertébrés</a>
							<ul class="dropdown-menu">
								<li><a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'mammal.' ? 'active' : '' }}" href="{{ path('mammal.index') }}">Les mammifères</a></li>
								<li><a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'bird.' ? 'active' : '' }}" href="{{ path('bird.index') }}">Les oiseaux</a></li>
								<li><a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'fish.' ? 'active' : '' }}" href="{{ path('fish.index') }}">Les poissons</a></li>
								<li><a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'reptile.' ? 'active' : '' }}" href="{{ path('reptile.index') }}">Les reptiles</a></li>
							</ul>
						</li>
						<li class="nav-item dropdown">
							<a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Les invertébrés</a>
							<ul class="dropdown-menu">														
								<li><a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'bryozoan.' ? 'active' : '' }}" href="{{ path('bryozoan.index') }}">Les Bryozoaires</a></li>
								<li><a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'cnidarian.' ? 'active' : '' }}" href="{{ path('cnidarian.index') }}">Les Cnidaires</a></li>
								<li><a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'crustacean.' ? 'active' : '' }}" href="{{ path('crustacean.index') }}">Les Crustacés</a></li>
								<li><a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'echinoderm.' ? 'active' : '' }}" href="{{ path('echinoderm.index') }}">Les Echinodermes</a></li>
								<li><a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'sponge.' ? 'active' : '' }}" href="{{ path('sponge.index') }}">Les Eponges</a></li>							
								<li><a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'mollusc.' ? 'active' : '' }}" href="{{ path('mollusc.index') }}">Les Mollusques</a></li>
								<li><a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'polychaete.' ? 'active' : '' }}" href="{{ path('polychaete.index') }}">Les Polychètes</a></li>														
								<li><a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'tunicate.' ? 'active' : '' }}" href="{{ path('tunicate.index') }}">Les Tuniciers</a></li>
							</ul>
						</li>
						<li class="nav-item dropdown">
							<a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">La flore</a>
							<ul class="dropdown-menu">					
								<li><a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'brown.' ? 'active' : '' }}" href="{{ path('brown.index') }}">Algues brunes</a></li>
								<li><a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'red.' ? 'active' : '' }}" href="{{ path('red.index') }}">Algues rouges</a></li>
								<li><a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'green.' ? 'active' : '' }}" href="{{ path('green.index') }}">Algues vertes</a></li>
								<li><a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'plant.' ? 'active' : '' }}" href="{{ path('plant.index') }}">Plantes à fleur</a></li>	
							</ul>
						</li>
						<li class="nav-item">
							<a class="nav-link {{ app.request.attributes.get('_route') starts with 'contact' ? 'active' : '' }}" aria-current="page" href="{{ path('contact') }}">Contact</a>
						</li>
					</ul>
				</div>
			</div>
		</nav>

		<div class="container my-4 flex-grow-1">
			{% include 'partials/flash.html.twig' %}
			{% block body %}{% endblock %}
		</div>

		<footer class="bg-primary text-center text-lg-start text-white mt-4">
			<div class="text-center p-3" style="background-color: rgba(0, 0, 0, 0.2);">
				© Copyright: Frager Philippe
			</div>
		</footer>

	</body>
</html>
