{% extends 'admin/admin.html.twig' %}

{% block title 'Cnidaires' %}

{% block body %}
	<div class="container w-75 mt-4 p-3 border rounded shadow">
		<div class="container p-4">
			<h1 class="text-center">Les cnidaires</h1>
		</div>

		<div class="mb-3 p-4 border rounded">
			{% include 'components/_search_data.html.twig' with {'form': form} only %}
		</div>

		<div class="container p-4">
			<p>
				<a class="btn btn-primary btn-sm" href="{{ path('admin.cnidarian.create') }}">Ajouter un cnidaire.</a>
			</p>
		</div>

		<div class="container p-4">
			<table class="table">
				<thead>
					<tr>
						<th>{{ knp_pagination_sortable(cnidarians, 'Nom', 'c.name') }}</th>
						<th>{{ knp_pagination_sortable(cnidarians, 'DCI', 'c.dci') }}</th>
						<th style="width: 217px">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for cnidarian in cnidarians %}
						<tr>
							<td>
								<a href="{{ path('admin.cnidarian.show', {id: cnidarian.id}) }}">{{ cnidarian.name }}</a>
							</td>
							<td>
								<a href="{{ path('admin.cnidarian.show', {id: cnidarian.id}) }}">{{ cnidarian.dci }}</a>
							</td>
							<td>
								<div class="d-flex gap-1">
									<a class="btn btn-primary btn-sm" href="{{ path('admin.cnidarian.edit', {id : cnidarian.id}) }}">Editer</a>
									<form action="{{ path('admin.cnidarian.delete', {id: cnidarian.id}) }}" method="POST">
										<input type="hidden" name="_method" value="DELETE">
										<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ cnidarian.id) }}">
										<button class="btn btn-danger btn-sm" type="submit">Supprimer</button>
									</form>
								</div>
							</td>
						</tr>
					</td>
				</tbody>
			</tr>
		{% endfor %}
	</tbody>
</table></div><div class="container p-4">
<div class="d-flex justify-content-center">{{ knp_pagination_render(cnidarians) }}</div></div></div>{% endblock %}
