{% extends 'admin/admin.html.twig' %}

{% block title 'Les algues rouges' %}

{% block body %}
	<div class="container w-75 mt-4">
		<div class="card shadow">
			
			<div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
				<h1 class="h3 mb-0 text-dark">Les algues rouges</h1>
				<a class="btn btn-primary btn-sm" href="{{ path('admin.red.create') }}">Ajouter une algue rouge</a>
			</div>

			<div class="card-body">
				<div class="mb-4 p-3 bg-light border rounded">
					{% include 'components/_search_data.html.twig' with {'form': form} only %}
				</div>

				<div class="table-responsive">
					<table class="table table-hover align-middle">
						<thead class="table-light">
							<tr>
								<th scope="col">{{ knp_pagination_sortable(reds, 'Nom', 'r.name') }}</th>
								<th scope="col">{{ knp_pagination_sortable(reds, 'DCI', 'r.dci') }}</th>
								<th scope="col" style="width: 217px" class="text-end pe-4">Actions</th>
							</tr>
						</thead>
						<tbody>
							{% for red in reds %}
								<tr>
									<td>
										<a href="{{ path('admin.red.show', {id: red.id}) }}" class="fw-bold text-decoration-none">{{ red.name }}</a>
									</td>
									<td>
										<a href="{{ path('admin.red.show', {id: red.id}) }}" class="text-decoration-none">{{ red.dci }}</a>
									</td>
									<td>
										<div class="d-flex gap-1 justify-content-end pe-3">
											<a class="btn btn-outline-primary btn-sm" href="{{ path('admin.red.edit', {id: red.id}) }}">Éditer</a>
											<form action="{{ path('admin.red.delete', {id: red.id}) }}" method="POST" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette algue rouge ?');">
												<input type="hidden" name="_method" value="DELETE">
												<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ red.id) }}">
												<button class="btn btn-outline-danger btn-sm" type="submit">Supprimer</button>
											</form>
										</div>
									</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="2" class="text-center text-muted py-4">Aucune algue rouge trouvée.</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>

				<div class="d-flex justify-content-center mt-4">
					{{ knp_pagination_render(reds) }}
				</div>
			</div>

		</div>
	</div>
{% endblock %}
