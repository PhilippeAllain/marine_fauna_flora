{% extends 'admin/admin.html.twig' %}

{% block title 'Oiseau : ' ~ bird.name %}

{% block body %}
	<div class="container w-50 mt-4 p-3 border rounded shadow">

		{% if bird is not null %}
			<h1 class="mb-4">Détails de l'oiseau : "{{ bird.name }}"</h1>
			<div class="card">
				<div class="card-body">
					{% if bird.thumbnail %}
						<div class="card-card-img-top mb-3">
							<img src="{{ vich_uploader_asset(bird, 'thumbnailFile') }}" alt="{{ bird.name }}" class="img-fluid mb-4" style="max-width: 200px;">
						</div>
					{% endif %}
					<div class="card-body">
						<h2 class="card-header">{{ bird.name }}</h2>

						<h3 class="card-title m-3">{{ bird.content | nl2br }}</h3>
						<p class="card-text m-3 text-center">
							<a href="{{ bird.url }}" target="_blank" class="btn btn-info mb-3">Voir la source</a>
						</p>
					</div>
				</div>
			</div>
		{% else %}
			<h1 class="mb-4">Oiseau non trouvé</h1>
			<p>L'oiseau que vous recherchez n'existe pas.</p>
		{% endif %}

		<div class="container my-4 justify-content-center d-flex gap-3">
			<a href="{{ path('admin.bird.index') }}" class="btn btn-primary">Retour</a>
		</div>
	{% endblock %}
