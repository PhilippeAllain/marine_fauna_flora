{% extends 'admin/admin.html.twig' %}

{% block title 'Ajouter un oiseau' %}


{% block body %}

	<div class="container mt-4 p-3 border rounded shadow">
		<h1 class="text-center m-4">Ajouter un oiseau</h1>
		<div class="card">
			<div class="card-body">
				{{ form_start(form) }}
				{{ form_row(form.name) }}
				{{ form_row(form.dci) }}
				{{ form_row(form.content) }}
				{{ form_row(form.thumbnailFile) }}
				{{ form_row(form.url) }}
					
				{{ form_end(form) }}
			</div>
		</div>
	</div>
	
{% endblock %}
