{% extends 'admin/admin.html.twig' %}

{% block title 'Oiseau : ' ~ (bird.name|default('Inconnu')) %}

{% block body %}
	<div class="container border rounded shadow p-3 mt-2 bg-white">

		{# Vérification plus robuste de l'existence de l'entité #}
		{% if bird is defined and bird is not null %}
			<h1 class="mb-4">Modifier l'oiseau : "{{ bird.name }}"</h1>

			<div class="card mb-3">
				{% if bird.thumbnailName is defined and bird.thumbnailName is not empty %}
					<div class="p-3 border-bottom bg-light text-center">
						<img src="{{ vich_uploader_asset(bird, 'thumbnailFile') }}" alt="{{ bird.name }}" class="img-fluid rounded" style="max-height: 200px; object-fit: contain;">
					</div>
				{% endif %}

				<div class="card-body">
					{{ form_start(form) }}
					{{ form_row(form.name) }}
					{{ form_row(form.dci) }}
					{{ form_row(form.content) }}
					{{ form_row(form.thumbnailFile) }}
					{{ form_row(form.url) }}
					{{ form_end(form) }}
				</div>
			</div>

			<div>
				{% set back_url = app.request.headers.get('referer') %}
				<a href="{{ back_url ?: path('admin.bird.index') }}" class="btn btn-sm btn-secondary">
					Retour
				</a>
			</div>
	
		{% else %}
			<h1 class="mb-4 text-danger">Oiseau non trouvé</h1>
			<p>L'oiseau que vous essayez de modifier n'existe pas.</p>
			<a href="{{ path('admin.bird.index') }}" class="btn btn-sm btn-primary">
				Retour à la liste
			</a>
		{% endif %}
	</div>
{% endblock %}

