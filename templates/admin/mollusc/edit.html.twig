{% extends 'admin/admin.html.twig' %}

{% block title 'Mollusque : ' ~ mollusc.name %}

{% block body %}
	<div class="container border rounded shadow">

		{% if mollusc is not null %}
			<h1 class="mb-4">Modifier le mollusque : "{{ mollusc.name }}"</h1>
			<div class="card">
				<img src="{{ vich_uploader_asset(mollusc, 'thumbnailFile') }}" alt="{{ mollusc.name }}" class="img-fluid mb-4" style="max-width: 200px;">
				<div class="card-body">
					{{ form_start(form) }}
					{{ form_row(form.name) }}
					{{ form_row(form.dci) }}
					{{ form_row(form.content) }}
					{{ form_row(form.thumbnailFile) }}
					{{ form_row(form.url) }}
					{{ form_end(form) }}
				</div>
			</div>
		</div>
	{% else %}
		<h1 class="mb-4">Mollusque non trouvé</h1>
		<p>Le mollusque que vous essayez de modifier n'existe pas.</p>
	{% endif %}
</div>

<div class="container my-4 justify-content-center d-flex gap-3">
	<a href="{{ path('admin.mollusc.index') }}" class="btn btn-primary">Retour</a>
</div>{% endblock %}
