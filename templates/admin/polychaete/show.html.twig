{% extends 'admin/admin.html.twig' %}

{% block title 'Polychète : ' ~ (polychaete.name|default('Inconnu')) %}

{% block body %}
	<div class="container w-100 mt-4 p-3 border rounded shadow bg-white">

		{% if polychaete is defined and polychaete is not null %}
			<h1 class="mb-4 text-center">Détails du polychète</h1>

			<div class="card shadow-sm">
				<div class="card-header bg-light">
					<h2 class="h5 mb-0 fw-bold">{{ polychaete.name }}</h2>
				</div>

				<div class="card-body text-center">
				
					{% if polychaete.thumbnailName is defined and polychaete.thumbnailName is not empty %}
						<div class="mb-3 text-center">
							<img src="{{ vich_uploader_asset(polychaete, 'thumbnailFile') }}" alt="{{ polychaete.name }}" class="img-fluid rounded mb-3 shadow-sm" style="max-height: 250px; object-fit: contain;">
						</div>
					{% endif %}
				
					<div class="card-body p-4">
					
					
						{# Affichage propre de la DCI / Description #}
						<div class="card-text text-muted lh-base mb-4 p-3 bg-white rounded border">
							{{ polychaete.content|default('Aucune description disponible.')|nl2br }}
						</div>

						{# Bouton Source si l'URL est renseignée #}
						{% if polychaete.url %}
							<div class="text-center">
								<a href="{{ polychaete.url }}" target="_blank" class="btn btn-info mt-2 border border-5 border-primary">
									<i class="bi bi-box-arrow-up-right me-1"></i> Voir la source
								</a>
							</div>
						{% endif %}
					</div>
				</div>
		{% else %}
			<div class="alert alert-danger text-center my-4" role="alert">
				<h4 class="alert-heading fw-bold">Polychète non trouvé</h4>
				<p class="mb-0">Le polychète que vous recherchez n'existe pas ou a été supprimé.</p>
			</div>
		{% endif %}

		{# Bouton Retour unifié #}
		<div class="d-flex justify-content-center mt-3">
			{% set back_url = app.request.headers.get('referer') %}
			{% set is_internal_url = back_url and app.request.host in back_url %}
			
			<a href="{{ is_internal_url ? back_url : path('admin.polychaete.index') }}" class="btn btn-secondary px-4 shadow-sm">
				Retour à la liste
			</a>
		</div>

	</div>
{% endblock %}
