{% extends 'admin/admin.html.twig' %}

{% block title 'Polychète : ' ~ (polychaete.name|default('Inconnu')) %}

{% block body %}
	<div class="container border rounded shadow p-3 mt-2 bg-white">

		{% if polychaete is defined and polychaete is not null %}
			<h1 class="mb-4">Modifier le polychète : "{{ polychaete.name }}"</h1>

			<div class="card mb-3">
				{% if polychaete.thumbnailName is defined and polychaete.thumbnailName is not empty %}
					<div class="p-3 border-bottom bg-light text-center">
						<img src="{{ vich_uploader_asset(polychaete, 'thumbnailFile') }}" alt="{{ polychaete.name }}" class="img-fluid rounded" style="max-height: 200px; object-fit: contain;">
					</div>
				{% endif %}

				<div class="card-body">
					{{ form_start(form) }}
					{{ form_row(form.name) }}
					{{ form_row(form.dci) }}
					{{ form_row(form.content) }}
					{{ form_row(form.thumbnailFile) }}
					{{ form_row(form.url) }}
					{{ form_end(form) }}
				</div>
			</div>

			<div>
				{% set back_url = app.request.headers.get('referer') %}
				<a href="{{ back_url ?: path('admin.polychaete.index') }}" class="btn btn-sm btn-secondary">
					Retour
				</a>
			</div>
	
		{% else %}
			<h1 class="mb-4 text-danger">Polychète non trouvé</h1>
			<p>Le polychète que vous essayez de modifier n'existe pas.</p>
			<a href="{{ path('admin.polychaete.index') }}" class="btn btn-sm btn-primary">
				Retour à la liste
			</a>
		{% endif %}
	</div>
{% endblock %}


