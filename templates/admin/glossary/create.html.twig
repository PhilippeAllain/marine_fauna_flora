{% extends 'admin/admin.html.twig' %}

{% block title 'Ajouter un terme du glossaire' %}

{% block body %}
	<div class="container mt-4 p-3 border rounded shadow">
		<h1 class="text-center m-4">Ajouter un terme au glossaire</h1>
		
		<div class="card shadow-sm">
			<div class="card-body">
				{{ form_start(form) }}
					{{ form_row(form.word) }}
					{{ form_row(form.content) }}
					{{ form_row(form.example) }}
					{{ form_row(form.thumbnailFile) }}
				{{ form_end(form) }}
			</div>
			<div class="mt-4">
				{% set back_url = app.request.headers.get('referer') %}
				<a href="{{ back_url ?: path('admin.glossary.index') }}" class="btn btn-secondary">
					Retour
				</a>
			</div>
		</div>
	</div>
{% endblock %}
