{% extends 'admin/admin.html.twig' %}

{% block title 'Ajouter un terme du glossaire' %}


{% block body %}

	<div class="container mt-4 p-3border rounded shadow">
		<h1 class="text-center m-4">Ajouter un terme au glossaire</h1>
		<div class="card">
			<div class="card-body">
				{{ form_start(form) }}
				{{ form_row(form.word) }}
				{{ form_row(form.content) }}
				{{ form_row(form.example) }}
				{{ form_end(form) }}
			</div>
		</div>
	</div>
	<div class="container my-4 justify-content-center d-flex gap-3">
		<a href="{{ path('admin.glossary.index') }}" class="btn btn-primary">Retour</a>
	</div>
	
{% endblock %}
