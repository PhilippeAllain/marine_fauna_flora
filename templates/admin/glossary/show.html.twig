{% extends 'admin/admin.html.twig' %}

{% block title 'Glossaire : ' ~ glossary.word %}

{% block body %}
	<div class="container mt-4">

		{% if glossary is not null %}
			<h1 class="mb-4">Détails du terme : "{{ glossary.word }}"</h1>
			<div class="card">
				<div class="card-body">
					<h5 class="card-title">{{ glossary.word }}</h5>
					{% if glossary.thumbnail %}
						<div class="card-card-img-top mb-3">
							<img src="{{ vich_uploader_asset(glossary, 'thumbnailFile') }}" alt="{{ glossary.word }}" class="img-fluid mb-4" style="max-width: 200px;">
						</div>
						<p class="card-text">{{ glossary.content | nl2br }}</p>
						<p class="card-text">
							<strong>Exemples:</strong>
							{{ glossary.example }}</p>
						<a href="{{ glossary.url }}" target="_blank" class="btn btn-info mb-3">Voir la source</a>
					{% endif %}
				</div>
			</div>
		</div>
	{% else %}
		<h1 class="mb-4">Terme du glossaire non trouvé</h1>
		<p>Le terme que vous recherchez n'existe pas.</p>
	{% endif %}

	<div class="container my-4 justify-content-center d-flex gap-3">
		<a href="{{ path('admin.glossary.index') }}" class="btn btn-primary">Retour</a>
	</div>
{% endblock %}
