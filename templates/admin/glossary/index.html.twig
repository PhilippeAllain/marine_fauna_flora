{% extends 'admin/admin.html.twig' %}

{% block title 'Glossaire' %}

{% block body %}
	<div class="container w-75 mt-4 p-3 border rounded shadow">
		<div class="container p-4">
			<h1 class="text-center">Glossaire</h1>
		</div>

		<div class="mb-3 p-4 border rounded">
			{% include 'components/_search_data.html.twig' with {'form': form} only %}
		</div>

		<div class="container p-4">
			<p>
				<a class="btn btn-primary btn-sm" href="{{ path('admin.glossary.create') }}">Ajouter un terme.</a>
			</p>
		</div>

		<div class="container p-4">
			<table class="table">
				<thead>
					<tr>
						<th>{{ knp_pagination_sortable(glossaries, 'Nom', 'g.word') }}</th>
						<th style="width: 217px">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for glossary in glossaries %}
						<tr>
							<td>
								<a href="{{ path('admin.glossary.show', {id: glossary.id}) }}">{{ glossary.word }}</a>
							</td>
							<td>
								<div class="d-flex gap-1">
									<a class="btn btn-primary btn-sm" href="{{ path('admin.glossary.edit', {id : glossary.id}) }}">Editer</a>
									<form action="{{ path('admin.glossary.delete', {id: glossary.id}) }}" method="POST">
										<input type="hidden" name="_method" value="DELETE">
										<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ glossary.id) }}">
										<button class="btn btn-danger btn-sm" type="submit">Supprimer</button>
									</form>
								</div>
							</td>
						</tr>
					</td>
				</tbody>
			</tr>
		{% endfor %}
	</tbody>
</table></div><div class="container p-4">
<div class="d-flex justify-content-center">{{ knp_pagination_render(glossaries) }}</div></div></div>{% endblock %}
