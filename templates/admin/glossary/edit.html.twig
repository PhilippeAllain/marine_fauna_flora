{% extends 'admin/admin.html.twig' %}

{% block title 'Glossaire : ' ~ (glossary ? glossary.word : 'Inconnu') %}

{% block body %}
	<div class="container border rounded shadow p-3 mt-2 bg-white w-auto vh-50" style="min-height: 400px;">
		{% if app.flashes('success') %}
			<div class="alert alert-success alert-dismissible fade show" role="alert">
				{{ app.flashes('success') }}
				<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
			</div>
		{% endif %}

		{% if glossary is not null %}
			<h1 class="mb-4">Modifier le terme : "{{ glossary.word }}"</h1>
		
			<div class="card mb-3">
				<div class="card-body">
					{{ form_start(form) }}
					{{ form_row(form.word) }}
					{{ form_row(form.content) }}
					{{ form_row(form.thumbnailFile) }}
					
					{% if glossary.thumbnailName is defined and glossary.thumbnailName %}
						<div class="mb-3">
							<img src="{{ vich_uploader_asset(glossary, 'thumbnailFile') }}" alt="{{ glossary.word }}" class="img-fluid rounded" style="max-width: 200px;">
						</div>
					{% endif %}

					<div class="mt-4">
						{% set back_url = app.request.headers.get('referer') %}
						<a href="{{ back_url ?: path('admin.glossary.index') }}" class="btn btn-secondary">
							Retour
						</a>
					</div>
					{{ form_end(form) }}
				</div>
			</div>
		{% else %}
			<h1 class="mb-4">Terme non trouvé</h1>
			<p>Le terme que vous essayez de modifier n'existe pas.</p>
			<a href="{{ path('admin.glossary.index') }}" class="btn btn-sm btn-primary">
				Retour à la liste
			</a>
		{% endif %}

	</div>
{% endblock %}
