<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<meta name="author" content="Philippe Frager"/>
		<meta property="og:description" content="Informations sur la faune et flore marine."/>
		<meta property="og:title" content="Marine Fauna Flora"/>
		<title>
			{% block title %}Administration{% endblock %}
		</title>

		{% block stylesheets %}{% endblock %}

		{% block javascripts %}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}
	</head>

	<body class="d-flex flex-column min-vh-100">
	
		<nav class="navbar navbar-expand-lg bg-body-tertiary">
			<div class="container-fluid">
				<a class="navbar-brand" href="{{ path('admin') }}">Administration</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="collapse navbar-collapse" id="navbarNav">
					<ul class="navbar-nav">
						<li class="nav-item">
							<a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin.glossary.' ? 'active' : '' }}" href="{{ path('admin.glossary.index') }}">Glossaire</a>
						</li>
						<li class="nav-item">
							<a class="nav-link {{ app.request.attributes.get('_route') starts with 'admin.sea.' ? 'active' : '' }}" href="{{ path('admin.sea.index') }}">Océans-Mers</a>
						</li>
						
						<!-- MENU : LES VERTÉBRÉS -->
						<li class="nav-item dropdown">
							<a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
								Les vertébrés
							</a>
							<ul class="dropdown-menu">
								<li>
									<a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'admin.mammal.' ? 'active' : '' }}" href="{{ path('admin.mammal.index') }}">Mammifères</a>
								</li>
								<li>
									<a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'admin.bird.' ? 'active' : '' }}" href="{{ path('admin.bird.index') }}">Oiseaux</a>
								</li>
								<li>
									<a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'admin.fish.' ? 'active' : '' }}" href="{{ path('admin.fish.index') }}">Poissons</a>
								</li>
								<li>
									<a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'admin.reptile.' ? 'active' : '' }}" href="{{ path('admin.reptile.index') }}">Reptiles</a>
								</li>
							</ul>
						</li>
						
						<!-- MENU : LES INVERTÉBRÉS -->
						<li class="nav-item dropdown">
							<a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
								Les invertébrés
							</a>
							<ul class="dropdown-menu">
								<li>
									<a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'admin.bryozoan.' ? 'active' : '' }}" href="{{ path('admin.bryozoan.index') }}">Bryozoaires</a>
								</li>
								<li>
									<a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'admin.cnidarian.' ? 'active' : '' }}" href="{{ path('admin.cnidarian.index') }}">Cnidaires</a>
								</li>
								<li>
									<a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'admin.crustacean.' ? 'active' : '' }}" href="{{ path('admin.crustacean.index') }}">Crustacés</a>
								</li>
								<li>
									<a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'admin.echinoderm.' ? 'active' : '' }}" href="{{ path('admin.echinoderm.index') }}">Échinodermes</a>
								</li>
								<li>
									<a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'admin.sponge.' ? 'active' : '' }}" href="{{ path('admin.sponge.index') }}">Éponges</a>
								</li>
								<li>
									<a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'admin.mollusc.' ? 'active' : '' }}" href="{{ path('admin.mollusc.index') }}">Mollusques</a>
								</li>
								<li>
									<a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'admin.polychaete.' ? 'active' : '' }}" href="{{ path('admin.polychaete.index') }}">Polychètes</a>
								</li>							
								<li>
									<a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'admin.tunicate.' ? 'active' : '' }}" href="{{ path('admin.tunicate.index') }}">Tuniciers</a>
								</li>
							</ul>
						</li>
						
						<!-- MENU : LA FLORE -->
						<li class="nav-item dropdown">
							<a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
								La flore
							</a>
							<ul class="dropdown-menu">
								<li>
									<a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'admin.brown.' ? 'active' : '' }}" href="{{ path('admin.brown.index') }}">Algues brunes</a>
								</li>
								<li>
									<a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'admin.red.' ? 'active' : '' }}" href="{{ path('admin.red.index') }}">Algues rouges</a>
								</li>
								<li>
									<a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'admin.green.' ? 'active' : '' }}" href="{{ path('admin.green.index') }}">Algues vertes</a>
								</li>
								<li>
									<a class="dropdown-item {{ app.request.attributes.get('_route') starts with 'admin.plant.' ? 'active' : '' }}" href="{{ path('admin.plant.index') }}">Plantes à fleurs</a>
								</li>
							</ul>
						</li>
					</ul>
				</div>
			</div>
		</nav>

		<div class="container my-4 flex-grow-1">
			{% include 'partials/flash.html.twig' %}
			{% block body %}{% endblock %}
		</div>

		<footer class="bg-primary text-center text-lg-start text-white mt-4">
			<div class="text-center p-3" style="background-color: rgba(0, 0, 0, 0.2);">
				© Copyright: Frager Philippe
			</div>
		</footer>
	</body>
</html>
