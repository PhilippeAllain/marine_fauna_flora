<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}Administration
			{% endblock %}
		</title>
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous"> {% block stylesheets %}{% endblock %}

		{% block javascripts %}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}
	</head>
	<body>
		<nav class="navbar bg-primary navbar-expand-lg" data-bs-theme="dark">
			<div class="container-fluid">
				<a class="navbar-brand" href="{{ path('admin.glossary.index') }}">Administration</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="collapse navbar-collapse" id="navbarNav">
					<ul class="navbar-nav">
						<li class="nav-item">
							<a class="nav-link {{ app.current_route() starts with 'admin.glossary.' ? 'active' : '' }}" href="{{ path('admin.glossary.index') }}">Glossaire</a>
						</li>
						<li class="nav-item">
							<a class="nav-link {{ app.current_route() starts with 'admin.sea.' ? 'active' : '' }}" href="{{ path('admin.sea.index') }}">Océans-Mers</a>
						</li>
						<li class="nav-item dropdown">
							<a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
								Les vertébrés marins
							</a>
							<ul class="dropdown-menu">
								<li class="nav-item">
									<a class="nav-link {{ app.current_route() starts with 'admin.mammal.' ? 'active' : '' }}" href="{{ path('admin.mammal.index') }}">Mammifères</a>
								</li>
								<li>
									<a class="dropdown-item {{ app.current_route() starts with 'admin.fish.' ? 'active' : '' }}" href="{{ path('admin.fish.index') }}">Poissons</a>
								</li>
								<li>
									<a class="dropdown-item" href="#">Something else here</a>
								</li>
							</ul>
						</li>
					</ul>
				</div>
			</div>
		</nav>
		<div class="container my-4">
			{% include 'partials/flash.html.twig' %}
			{% block body %}{% endblock %}
		</div>

		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
		<footer class="bg-primary text-center text-lg-start text-white mt-4 fixed-bottom">
			<div class="text-center p-3" style="background-color: rgba(0, 0, 0, 0.2);">
				© Copyright: Frager Philippe
			</div>
		</footer>
	</body>
</html>
